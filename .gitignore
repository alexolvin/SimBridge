# Tasks (local only — never committed)
.tasks/

# Environment & secrets
.env
.env.*
*.secret
*.key

# SimBridge — NEVER commit these
*.session
*.session-journal
config/simbridge.yaml          # real config (only .example.yaml is tracked)
/etc/simbridge/env             # systemd environment file
/var/lib/simbridge/            # session, recordings, data
/var/log/simbridge/            # audit logs

