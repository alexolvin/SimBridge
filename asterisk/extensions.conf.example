; SimBridge dialplan — example
; Copy to /etc/asterisk/extensions_custom.conf and adapt.
;
; chan_dongle routes incoming events into the 'incoming-mobile' context:
;   s       — incoming call from GSM
;   sms     — incoming SMS
;   report  — delivery report
;   ussd    — USSD response
;
; The 'tg-bridge' context handles calls from the Telegram voice bridge (S04.2).
;
; Timings are driven by config (S03.2). The file asterisk-globals.conf
; is generated at deploy/reload time by scripts/generate_asterisk_config.py
; and must be loaded via a `globals.conf` include (see deploy docs).
;
; Post-Stage-04 flow:
;   - Incoming call first rings user via Telegram (Stage 04)
;   - Voicemail is the fallback when unanswered (S03.4)
;   - See docs/voice-bridge.md for architecture details.

; ---------------------------------------------------------------------------
; Include generated globals (ring_wait_seconds, max_record_seconds, prompt, etc.)
; Generated by scripts/generate_asterisk_config.py
; ---------------------------------------------------------------------------
; include => asterisk-globals.conf

; ===========================================================================
; [incoming-mobile] — GSM inbound (chan_dongle)
; ===========================================================================
[incoming-mobile]
; ---------------------------------------------------------------------------
; Incoming call → Telegram ring → voicemail fallback (S04.3)
; Current: voicemail fallback (pre-Stage-04, S03.4)
; Post-Stage-04: try tg-bridge first, fall through to voicemail
; ---------------------------------------------------------------------------
exten => s,1,NoOp(Incoming call from ${DONGLE_CALLERID})
 same => n,Set(CALL_FROM=${DONGLE_CALLERID})
 same => n,Set(GLOBAL(VM_CALL_FROM)=${DONGLE_CALLERID})
; Pre-Stage-04: voicemail is the only outcome. Stage 04 inserts Telegram ring.
 same => n,Dial(Local/voicemail-fallback@voicemail-ctx,${RING_WAIT_SECONDS})
 same => h,Hangup()

; ---------------------------------------------------------------------------
; Incoming SMS → forward to Telegram via HTTP
; ---------------------------------------------------------------------------
exten => sms,1,NoOp(Incoming SMS from ${DONGLE_FROM}: ${DONGLE_TEXT})
 same => n,Set(FROM=${DONGLE_FROM})
 same => n,Set(TEXT=${DONGLE_TEXT})
 same => n,System(/usr/local/bin/tg-sms-forward.sh "${DONGLE_FROM}" "${DONGLE_TEXT}")
 same => n,Hangup()

; ---------------------------------------------------------------------------
; Delivery report → forward to Telegram as reply
; ---------------------------------------------------------------------------
exten => report,1,NoOp(Delivery report from ${DONGLE_FROM})
 same => n,System(/usr/local/bin/tg-sms-forward.sh "${DONGLE_FROM}" "__DELIVERY_REPORT__")
 same => n,Hangup()

; ===========================================================================
; [tg-bridge] — Telegram → GSM (outbound call from bridge)
; ===========================================================================
; The tg-bridge (sip-tg-bridge) dials into Asterisk on this context when the
; Telegram user wants to place an outbound call. The phone number is passed
; as the called number from the bridge (set by the agent via AMI).
;
; S04.2: Outbound call flow (Telegram → GSM)
; S04.3: Full state machine with ACL check, modem reservation, hangup cleanup
; ===========================================================================
[tg-bridge]
exten => s,1,NoOp(Inbound call from tg-bridge)
 same => n,Set(CALL_TYPE=outbound)
 same => n,Set(ORIG_CALL_FROM=${CALLERID(num)})
; The called number (GSM target) is passed via EXTEN by the bridge
; For now: route to voicemail as placeholder. S04.3 adds GSM dial logic.
 same => n,Gosub(vmb-notify,s,1)
 same => n,Hangup()

; Notify the agent that the bridge called (S04.3: full call control)
exten => vmb-notify,1,NoOp(Voicemail branch notification)
 same => n,Hangup()

; ===========================================================================
; [voicemail-ctx] — Voicemail recording (reusable branch, S03.4)
; ===========================================================================
; Callable from:
;   - incoming-mobile (current: unconditional)
;   - tg-bridge (fallback for outbound calls)
;   - Stage 04 state machine (Telegram ring unanswered → voicemail)
; ===========================================================================
[voicemail-ctx]

; Unconditional entry (current behavior, pre-Stage-04)
exten => voicemail-fallback,1,NoOp(Voicemail fallback — unconditional)
 same => n,Gosub(voicemail-record,s,1)
 same => n,Hangup()

; Voicemail recording sub — reusable by Stage 04
exten => voicemail-record,1,NoOp(Voicemail recording start)
 same => n,Answer()
 same => n,Wait(1)
 same => n,Set(MIXMON_DIR=/var/lib/simbridge/recordings)
 same => n,Set(MIXMON_FORMAT=wav)
 same => n,Set(CORRELATION=${UNIQUEID})
 same => n,Set(GLOBAL(VM_CORRELATION)=${UNIQUEID})
 same => n,Set(GLOBAL(VM_CALL_FROM)=${CALL_FROM})
; S03.1: MixMonitor starts BEFORE Playback so early hangups are captured
 same => n,MixMonitor(${MIXMON_DIR}/${CORRELATION}.${MIXMON_FORMAT},@hangup-handler)
 same => n,Playback(${VM_PROMPT})
; Set PROMPT_DONE flag — hangup handler checks duration to distinguish early hangup
 same => n,Set(PROMPT_DONE=${EPOCH})
 same => n,WaitExten(${MAX_RECORD_SECONDS})
 same => n,StopMixMonitor()
 same => n,Hangup()

; Post-hangup: forward recording to Telegram, detect early hangup
exten => hangup-handler,1,NoOp(Hangup handler — processing voicemail)
 same => n,Set(VMFILE=/var/lib/simbridge/recordings/${VM_CORRELATION}.wav)
 same => n,System(/usr/local/bin/tg-voice-forward.sh "${VM_CORRELATION}" "${VM_CALL_FROM}" "${VMFILE}")