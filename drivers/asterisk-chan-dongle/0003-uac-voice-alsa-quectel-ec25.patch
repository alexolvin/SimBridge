+/*!
+ * \brief Open and configure one ALSA PCM stream for UAC voice
+ *
+ * Voice on the EC25 UAC card is 8 kHz 16-bit mono (Asterisk slin).
+ *
+ * \param dev -- ALSA device string from dongle.conf (e.g. "hw:CARD=EC25EUX,DEV=0")
+ * \param stream -- SND_PCM_STREAM_CAPTURE or SND_PCM_STREAM_PLAYBACK
+ * \param pvt -- device (for logging)
+ * \return snd_pcm_t* on success, NULL on failure
+ */
+static snd_pcm_t * alsa_card_init(const char * dev, snd_pcm_stream_t stream, struct pvt * pvt)
+{
+	snd_pcm_t * handle = NULL;
+	snd_pcm_hw_params_t * hw;
+	snd_pcm_sw_params_t * sw;
+	unsigned int rate = 8000;
+	snd_pcm_uframes_t period = FRAME_SIZE;		/* 320 samples = 40 ms */
+	snd_pcm_uframes_t buffer = FRAME_SIZE * 25;	/* 8000 samples = 1 s */
+	int period_align = 0;
+	const char * dir = (stream == SND_PCM_STREAM_CAPTURE) ? "capture" : "playback";
+	int err;
+
+	if (!dev || !dev[0])
+	{
+		ast_log (LOG_ERROR, "[%s] UAC mode enabled but alsadev is empty\n", PVT_ID(pvt));
+		return NULL;
+	}
+
+	err = snd_pcm_open(&handle, dev, stream, SND_PCM_NONBLOCK);
+	if (err < 0)
+	{
+		ast_log (LOG_ERROR, "[%s] snd_pcm_open(%s, %s) failed: %s\n", PVT_ID(pvt), dev, dir, snd_strerror(err));
+		return NULL;
+	}
+
+	snd_pcm_hw_params_alloca(&hw);
+	if ((err = snd_pcm_hw_params_any(handle, hw)) < 0 ||
+	    (err = snd_pcm_hw_params_set_access(handle, hw, SND_PCM_ACCESS_RW_INTERLEAVED)) < 0 ||
+	    (err = snd_pcm_hw_params_set_format(handle, hw, SND_PCM_FORMAT_S16_LE)) < 0 ||
+	    (err = snd_pcm_hw_params_set_channels(handle, hw, 1)) < 0)
+	{
+		ast_log (LOG_ERROR, "[%s] ALSA %s %s params failed: %s\n", PVT_ID(pvt), dev, dir, snd_strerror(err));
+		goto fail;
+	}
+
+	if ((err = snd_pcm_hw_params_set_rate_near(handle, hw, &rate, 0)) < 0)
+	{
+		ast_log (LOG_ERROR, "[%s] ALSA %s %s rate failed: %s\n", PVT_ID(pvt), dev, dir, snd_strerror(err));
+		goto fail;
+	}
+	if (rate != 8000)
+		ast_log (LOG_WARNING, "[%s] ALSA %s: 8000 Hz not supported, using %u Hz\n", PVT_ID(pvt), dev, rate);
+
+	if ((err = snd_pcm_hw_params_set_period_size_near(handle, hw, &period, &period_align)) < 0 ||
+	    (err = snd_pcm_hw_params_set_buffer_size_near(handle, hw, &buffer)) < 0)
+	{
+		ast_log (LOG_ERROR, "[%s] ALSA %s %s period/buffer failed: %s\n", PVT_ID(pvt), dev, dir, snd_strerror(err));
+		goto fail;
+	}
+	if (period != FRAME_SIZE)
+		ast_log (LOG_WARNING, "[%s] ALSA %s: period %lu samples, expected %d\n", PVT_ID(pvt), dev, (unsigned long) period, FRAME_SIZE);
+
+	if ((err = snd_pcm_hw_params(handle, hw)) < 0)
+	{
+		ast_log (LOG_ERROR, "[%s] ALSA %s %s hw_params failed: %s\n", PVT_ID(pvt), dev, dir, snd_strerror(err));
+		goto fail;
+	}
+
+	snd_pcm_sw_params_alloca(&sw);
+	if ((err = snd_pcm_sw_params_current(handle, sw)) < 0 ||
+	    (err = snd_pcm_sw_params_set_start_threshold(handle, sw, (stream == SND_PCM_STREAM_CAPTURE) ? 1 : FRAME_SIZE)) < 0 ||
+	    (err = snd_pcm_sw_params_set_stop_threshold(handle, sw, buffer)) < 0)
+	{
+		ast_log (LOG_ERROR, "[%s] ALSA %s %s sw_params failed: %s\n", PVT_ID(pvt), dev, dir, snd_strerror(err));
+		goto fail;
+	}
+
+	if ((err = snd_pcm_sw_params(handle, sw)) < 0)
+	{
+		ast_log (LOG_ERROR, "[%s] ALSA %s %s sw_params apply failed: %s\n", PVT_ID(pvt), dev, dir, snd_strerror(err));
+		goto fail;
+	}
+
+	return handle;
+
+fail:
+	snd_pcm_close(handle);
+	return NULL;
+}
+
+/*!
+ * \brief Open the UAC ALSA capture and playback streams
+ * \param pvt -- device
+ * \return capture poll fd for channel select(), or -1 on failure
+ */
+static int soundcard_init(struct pvt * pvt)
+{
+	const char * dev = CONF_UNIQ(pvt, alsadev);
+	struct pollfd pfd;
+	int err;
+
+	pvt->icard = alsa_card_init(dev, SND_PCM_STREAM_CAPTURE, pvt);
+	if (!pvt->icard)
+		return -1;
+
+	pvt->ocard = alsa_card_init(dev, SND_PCM_STREAM_PLAYBACK, pvt);
+	if (!pvt->ocard)
+	{
+		snd_pcm_close(pvt->icard);
+		pvt->icard = NULL;
+		return -1;
+	}
+
+	/* prepare playback so snd_pcm_writei deterministically auto-starts
+	 * from PREPARED (no immediate underrun from an empty buffer) */
+	if (snd_pcm_prepare(pvt->ocard) < 0)
+		ast_log (LOG_WARNING, "[%s] ALSA playback prepare failed\n", PVT_ID(pvt));
+
+	/* prepare and drain capture */
+	if (snd_pcm_prepare(pvt->icard) < 0 || snd_pcm_drop(pvt->icard) < 0)
+		ast_log (LOG_WARNING, "[%s] ALSA capture prepare/drop failed\n", PVT_ID(pvt));
+
+	err = snd_pcm_poll_descriptors(pvt->icard, &pfd, 1);
+	if (err < 1)
+	{
+		ast_log (LOG_ERROR, "[%s] snd_pcm_poll_descriptors failed\n", PVT_ID(pvt));
+		snd_pcm_close(pvt->icard);
+		snd_pcm_close(pvt->ocard);
+		pvt->icard = pvt->ocard = NULL;
+		return -1;
+	}
+
+	ast_verb (3, "[%s] UAC voice card %s opened (capture fd %d)\n", PVT_ID(pvt), dev, pfd.fd);
+	return pfd.fd;
+}
