[Unit]
Description=SimBridge Agent — GSM-node HTTP API
After=network-online.target tailscaled.service asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=simbridge
Group=nogroup
WorkingDirectory=/opt/simbridge
ExecStart=/opt/simbridge-venv/bin/python -m agent.main
Restart=on-failure
RestartSec=5
WatchdogSec=120
TimeoutStartSec=30
TimeoutStopSec=15

# Secrets via environment — NEVER in the unit file
EnvironmentFile=/etc/simbridge/env
Environment=SIMBRIDGE_CONFIG=/etc/simbridge/simbridge.yaml

# Only the Tailscale interface should be reachable
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/simbridge /var/lib/simbridge
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
